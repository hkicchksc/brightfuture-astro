---
import AwardeeLayout from '../../../layouts/AwardeeLayout.astro';
const description = "非常感恩能夠獲得鵬程創意獎學金這個榮譽,我在這個作品上用了很多時間和心血,當中亦學習了很多藝術創作的知識。鵬程創意獎學金給了我一個很大的鼓勵,使我對未來創作的路上增加了許多信心和力量。";
const gallery = ["/images/25-26/黃恩朗1.webp", "/images/25-26/黃恩朗2.webp"];
---
<AwardeeLayout
  title="黃恩朗 | 25/26 鵬程創意獎學金"
  name="黃恩朗"
  englishName="Wong Yan Long Ashley"
  year="25/26"
  category="裝置/空間"
  class="5X6"
  photo="/images/25-26/黃恩朗.webp"
  description={description}
  gallery={gallery}
/>
