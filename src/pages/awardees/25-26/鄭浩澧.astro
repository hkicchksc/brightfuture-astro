---
import AwardeeLayout from '../../../layouts/AwardeeLayout.astro';
const description = `感謝導師、朋友、同學、書院、所有曾幫助我的人，以及鵬程慈善基金。

獎學金肯定了我這三年在書院的學習，並支持我繼續創作。未來的我會好好利用在書院學到的一切，保持初心，繼續關懷社會。`;
const gallery = ["/images/25-26/鄭浩澧1.webp", "/images/25-26/鄭浩澧2.webp", "/images/25-26/鄭浩澧3.webp"];
---
<AwardeeLayout
  title="鄭浩澧 | 25/26 鵬程創意獎學金"
  name="鄭浩澧"
  englishName="Cheng Ho Lai"
  year="25/26"
  category="裝置/空間"
  class="6X1"
  photo="/images/25-26/鄭浩澧.webp"
  description={description}
  gallery={gallery}
/>
